# Copy this file to .streamlit/secrets.toml for local testing (gitignored),
# or paste its contents into the "Secrets" box of your Streamlit Community
# Cloud app settings for a deployed instance that should show real results.
#
# Omit this section entirely to run in demo mode (bundled synthetic sample).
#
# `token` MUST be a fine-grained GitHub personal access token scoped to ONLY
# the private data repo below, with "Contents: Read-only" permission and
# nothing else. Never use a broad/classic token here.

[real_data_source]
repo  = "your-github-username/your-private-data-repo"
token = "github_pat_..."
ref   = "main"
